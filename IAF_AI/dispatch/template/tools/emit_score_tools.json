[
  {
    "type": "function",
    "function": {
      "name": "emit_scores",
      "description": "提交对所有方案的评分。你必须对上下文中呈现的每一份方案都给出评分。对每份方案逐维打分并合成总分（正数，无上限）。你的总分将被归一化为权重（总和=1），权重决定你的押注分配。必须调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "evaluations": {
            "type": "array",
            "description": "对每份方案的评分数组，数组长度必须等于方案总数",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "description": "方案作者名（与上下文中标注的作者名一致）"
                },
                "dimension_scores": {
                  "type": "array",
                  "description": "按 rubric 各维度的打分明细",
                  "items": {
                    "type": "object",
                    "properties": {
                      "dimension": {"type": "string", "description": "维度名称"},
                      "score": {"type": "number", "description": "该维度得分（正数）"},
                      "reasoning": {"type": "string", "description": "该维度的评分理由"}
                    },
                    "required": ["dimension", "score", "reasoning"]
                  }
                },
                "total_score": {
                  "type": "number",
                  "description": "各维度加权合成的总分（正数，无上限）。总分越高表示越看好该方案"
                },
                "summary": {
                  "type": "string",
                  "description": "对该方案的整体评价概要"
                }
              },
              "required": ["target", "dimension_scores", "total_score", "summary"]
            }
          }
        },
        "required": ["evaluations"]
      }
    }
  }
]
